# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/insurance_agent

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_POLICY_COLLECTION=insurance_policies
QDRANT_CLAIM_COLLECTION=insurance_claims
QDRANT_TIMEOUT_SECONDS=60

# LiteLLM Proxy
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_API_KEY=sk-local-dev-key
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=4096
# Set prompt if the upstream does not support response_format=json_object.
LLM_JSON_MODE=json_object

# Any OpenAI-compatible upstream, reachable from the LiteLLM container.
# Use the provider's API base URL (typically ending in /v1) and exact model ID.
# Compose adds the openai/ provider prefix; do not include it in LLM_MODEL.
LLM_API_BASE=http://host.docker.internal:8001/v1
LLM_MODEL=your-model-id
# For an upstream without authentication, use a non-empty placeholder.
LLM_API_KEY=not-needed

# LLM Model Assignments (configurable per agent)
SUPERVISOR_MODEL=claims-model
INTAKE_MODEL=claims-model
TRIAGE_MODEL=claims-model
POLICY_MODEL=claims-model
FRAUD_MODEL=claims-model
MEDICAL_MODEL=claims-model
SUMMARY_MODEL=claims-model
DUPLICATE_MODEL=claims-model

# Embeddings & Reranking (CPU)
BGE_M3_MODEL_PATH=BAAI/bge-m3
BGE_RERANKER_MODEL_PATH=BAAI/bge-reranker-v2-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_LENGTH=8192
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=1024
RAG_CHUNK_MAX_TOKENS=512
RAG_UPSERT_BATCH_SIZE=32
RAG_CANDIDATE_COUNT=20
RAG_RESULT_COUNT=5
DOCLING_NUM_THREADS=4
DOCLING_MAX_PAGES=500
DOCLING_ENABLE_OCR=true

# Decision Thresholds
AUTO_APPROVE_CONFIDENCE=0.85
HUMAN_REVIEW_CONFIDENCE=0.60
FRAUD_ALERT_THRESHOLD=0.70

# Phase 4 reference matching and screening. Mount a versioned JSON catalog
# into celery-worker; see docs/agents.md for its format.
# No catalog means medical claims require human coding review.
MEDICAL_CODE_REFERENCE_PATH=
MEDICAL_CODE_CANDIDATE_COUNT=20
FRAUD_HISTORY_DAYS=365
FRAUD_HISTORY_LIMIT=50

# Redis Broker
REDIS_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CLAIM_TASK_MAX_RETRIES=3
CLAIM_TASK_TIMEOUT_SECONDS=1800
DUPLICATE_SIMILARITY_THRESHOLD=0.92
DUPLICATE_CANDIDATE_COUNT=5

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=/app/uploads
MAX_CLAIM_IMAGES=10
MAX_IMAGE_PIXELS=40000000
MAX_FNOL_TEXT_LENGTH=20000
