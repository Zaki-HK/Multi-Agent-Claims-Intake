# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/insurance_agent

# Qdrant
QDRANT_URL=http://qdrant:6333

# LiteLLM Proxy
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_API_KEY=sk-local-dev-key

# LLM Model Assignments (configurable per agent)
SUPERVISOR_MODEL=gemma3
INTAKE_MODEL=gemma3
TRIAGE_MODEL=gemma3
POLICY_MODEL=gemma3
FRAUD_MODEL=gemma3
MEDICAL_MODEL=gemma3
SUMMARY_MODEL=gemma3
DUPLICATE_MODEL=gemma3

# Embeddings & Reranking (CPU)
BGE_M3_MODEL_PATH=BAAI/bge-m3
BGE_RERANKER_MODEL_PATH=BAAI/bge-reranker-v2-m3
EMBEDDING_DEVICE=cpu

# Decision Thresholds
AUTO_APPROVE_CONFIDENCE=0.85
HUMAN_REVIEW_CONFIDENCE=0.60
FRAUD_ALERT_THRESHOLD=0.70

# Redis Broker
REDIS_URL=redis://redis:6379/0

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=/app/uploads
